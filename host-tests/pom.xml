<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.android.car</groupId>
  <artifactId>car-service-host-regression</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>Car service Java host regression</name>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>11</maven.compiler.release>
  </properties>
  <dependencies>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
    <dependency><groupId>com.google.truth</groupId><artifactId>truth</artifactId><version>1.4.4</version><scope>test</scope></dependency>
    <dependency><groupId>com.google.guava</groupId><artifactId>guava</artifactId><version>33.3.1-jre</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <!-- Compile the original production sources; no copied source or platform stubs. -->
    <sourceDirectory>${project.basedir}/../service/src</sourceDirectory>
    <testSourceDirectory>${project.basedir}/../tests/carservice_unit_test/src</testSourceDirectory>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId><version>3.4.0</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version>
        <configuration>
          <includes>
            <include>com/android/car/pm/WindowDumpParser.java</include>
            <include>com/android/car/util/SetMultimap.java</include>
            <include>com/android/car/util/SlidingWindow.java</include>
            <include>com/android/car/watchdog/TimeSource.java</include>
          </includes>
          <testIncludes>
            <testInclude>com/android/car/pm/WindowDumpParserTest.java</testInclude>
            <testInclude>com/android/car/SetMultimapTest.java</testInclude>
            <testInclude>com/android/car/SlidingWindowTest.java</testInclude>
            <testInclude>com/android/car/watchdog/TimeSourceTest.java</testInclude>
          </testIncludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version>
        <configuration><failIfNoTests>true</failIfNoTests><forkedProcessTimeoutInSeconds>60</forkedProcessTimeoutInSeconds></configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.8.1</version></plugin>
    </plugins>
  </build>
</project>
